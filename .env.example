# --- Kiln (Bricksum NPU inference) — server only ---
KILN_API_KEY=sk-bk-xxxxxxxxxxxxxxxxxxxx
KILN_BASE_URL=https://api.bricksum.com/v1
KILN_MODEL=qwen3-32b
# Qwen3 '/no_think' on the propose step (1 = on). Measured 2026-09-27: 160 -> 47 completion tokens, same 5/5 tool calls.
KILN_NO_THINK=1

# --- Agent wallet (Sepolia testnet ONLY; fresh dev wallet, never a personal key) ---
AGENT_PRIVATE_KEY=0x................................................................
# Optional. Empty = PublicNode's keyless endpoint (https://ethereum-sepolia-rpc.publicnode.com).
# Set an Alchemy/Infura URL here only if PublicNode is slow or rate-limits you.
SEPOLIA_RPC_URL=

# --- Demo economics (labeled assumptions shown in the UI) ---
# Mandate is in USD; settlement is test ETH at this fixed demo rate.
DEMO_ETH_USD=4000
# Energy estimate: joules per PROCESSED token (prompt + completion); /api/usage computes
# totalWh = totalTokens x ENERGY_J_PER_TOKEN / 3600. Default below is a stated upper bound:
# RNGD TDP 180 W x 1.233 s per proposal / 517 tokens per proposal (measured 2026-09-28).
# Replace with an on-site Bricksum/Furiosa figure if one is given.
ENERGY_J_PER_TOKEN=0.429
# Where the assumption comes from (shown next to the number). No # characters in this value.
ENERGY_SOURCE="Upper bound, per processed (prompt+completion) token: FuriosaAI RNGD card TDP 180 W (furiosa.ai/renegade-spec) x measured 1.233 s per proposal / 517 tokens per proposal (docs/reasoning-comparison.json, thinking off, 2026-09-28). Assumes one card fully dedicated to one request; batched serving uses less."
# Frontend data mode: mock (fixtures) or live (this backend). Set live after integration.
NEXT_PUBLIC_API_MODE=live

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# server only, never NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJ...
