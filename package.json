{
  "name": "perdiem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx tests/policy.test.ts && tsx --conditions=react-server tests/view.test.ts && tsx tests/mandate-request.test.ts && tsx --conditions=react-server tests/ledger-write.test.ts && tsx --conditions=react-server tests/db-error.test.ts && tsx --conditions=react-server tests/http-json.test.ts && tsx --conditions=react-server tests/audit.test.ts && tsx --conditions=react-server tests/events.test.ts && tsx components/perdiem/evidence-records.check.ts && tsx tests/rule-checks.test.ts",
    "seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "scenario": "tsx --conditions=react-server --env-file=.env.local scripts/scenario.ts",
    "export": "tsx --conditions=react-server --env-file=.env.local scripts/export.ts",
    "verify": "tsx --env-file-if-exists=.env.local scripts/verify.ts",
    "compare": "tsx --conditions=react-server --env-file=.env.local scripts/compare-reasoning.ts",
    "metrics": "tsx --conditions=react-server --env-file=.env.local scripts/metrics.ts",
    "spike": "tsx --conditions=react-server --env-file=.env.local scripts/spike.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "openai": "^7.23.0",
    "pretendard": "^1.3.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
